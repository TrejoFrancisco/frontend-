{
  "expo": {
    "name": "Restaurante",
    "owner": "xolotl-creative-labs",
    "slug": "sistema-web",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/cuchilleria(1).png",
      "resizeMode": "contain",
      "backgroundColor": "#5BA3D9"
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#5BA3D9"
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "networkSecurityConfig": "./network_security_config.xml",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#5BA3D9"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.xolotlcreative.sistemaRestaurante",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b5958646-ebf9-4595-baf5-9357e866ca89"
      }
    }, "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir que $(PRODUCT_NAME) acceda a tus fotos.",
          "savePhotosPermission": "Permitir que $(PRODUCT_NAME) guarde fotos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
